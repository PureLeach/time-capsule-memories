# Copy to .env before starting the stack: cp example.env .env
#
# Every value below is a throwaway local credential. Replace all of them before
# running this anywhere reachable — see the Security section of the README.

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB_NAME=time_capsule
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}?sslmode=disable"

# pgAdmin (development override only)
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# MinIO — MINIO_ENDPOINT must be reachable under the same name from both the
# backend and the browser, or presigned upload signatures will not validate.
MINIO_ROOT_USER=minioaccesskey
MINIO_ROOT_PASSWORD=miniosecretkey
MINIO_ENDPOINT=minio-api.localhost
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=time-capsule

# SMTP — MailHog needs no auth, so SMTP_PASSWORD stays empty. Point SMTP_HOST at
# a real relay and set SMTP_PASSWORD to enable PLAIN auth.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=time-capsule@example.com
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# Scheduler — standard 5-field cron expression, evaluated in UTC.
CRON_CAPSULE_DISPATCH="*/1 * * * *"

# Logging: debug | info | warn | error
LOG_LEVEL=info

# HTTP
CORS_ALLOWED_ORIGINS=http://frontend.localhost,http://localhost:8001

# Exposes POST /send-test-email. It is unauthenticated and can send mail to any
# address through the relay above, so leave it false outside local development.
ENABLE_TEST_EMAIL_ENDPOINT=false

# Frontend — read by Vite at build time.
VITE_BACKEND_API_URL=http://backend.localhost
