# Backend settings for running `make run` on the host against the containers in
# docker-compose-dev.yml. Copy to .env: cp example-dev.env .env
#
# These are throwaway local credentials. Never reuse them anywhere reachable.

# PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB_NAME=time_capsule
DATABASE_URL="postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB_NAME}?sslmode=disable"

# pgAdmin
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin

# MinIO
MINIO_ROOT_USER=minioaccesskey
MINIO_ROOT_PASSWORD=miniosecretkey
MINIO_ENDPOINT=localhost:9000
MINIO_USE_SSL=false
MINIO_BUCKET_NAME=time-capsule

# SMTP — MailHog accepts anything and requires no auth, so SMTP_PASSWORD is empty.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=time-capsule@example.com
SMTP_PASSWORD=
SMTP_TIMEOUT=10

# Scheduler — standard 5-field cron expression, evaluated in UTC.
CRON_CAPSULE_DISPATCH="*/1 * * * *"

# Logging
LOG_LEVEL=debug

# HTTP
CORS_ALLOWED_ORIGINS=http://frontend.localhost,http://localhost:8001

# Unauthenticated SMTP smoke-test endpoint. Local development only.
ENABLE_TEST_EMAIL_ENDPOINT=true
